    {
      "id": "registration",
      "caption": "Registration and coverage",
      "columns": [
        "Question/module",
        "Status and article coverage"
      ],
      "rows": [
        [
          "Registration",
          "OSF https://osf.io/u2w7d/, 10 November 2026, embargoed secondary-data registration. Initial source classification, explanation and common-component findings were known and disclosed; the source was not unseen data."
        ],
        [
          "Primary methodological endpoint",
          "Completed: additional-initialization ocular-regression faithfulness contrast (Section S6). Earlier initialization remains separate."
        ],
        [
          "Primary external endpoint",
          "Incomplete: Wroclaw physical units unconfirmed; provisional native-as-microvolt evaluation does not complete the verified-unit endpoint (Section S7)."
        ],
        [
          "1--3 Training and predictors",
          "Initializations, stopping, alternative folds, all five longer-training checkpoints, CNN and spectral comparisons completed (Section S3); selected probability/map summaries only."
        ],
        [
          "4--7 Explanation controls",
          "Background, full-cohort IG, parameter/label randomization, normalized/probability/energy perturbation, confidence/correctness, deletion and donor comparisons completed; details and coverage in docs/additional_analyses.md and results/aggregate.json. Full-cohort/panel comparison uses their 40-person overlap."
        ],
        [
          "8--10 Components, transforms, covariates",
          "Inference removal and reference robustness specified before execution with motivating source findings known. Component features, surface Laplacian, demographics/quality and training-only residualization completed (Sections S3--S5)."
        ],
        [
          "11 Quality/clinical subsets",
          "Strict-quality and matched fits completed. Diagnosis-independent acquisition mapping and adjudicated medication/comorbidity fields unavailable; corresponding subsets not constructed."
        ],
        [
          "12 Temporal robustness",
          "Early/late within-record comparisons completed; no independent test--retest cohort (docs/additional_analyses.md)."
        ],
        [
          "13--14 External and conditional task cohorts",
          "Wroclaw provisional classification reported; external explanation contrasts not presented. Conditional Woltering--Gu and Breitling analyses not undertaken."
        ],
        [
          "15 Reproducibility",
          "Predictions and implementation/numerical checks support reported analyses; coverage does not imply every registered diagnostic is presented."
        ],
        [
          "Later exploratory analyses",
          "Common-only neural retraining, common-power and auxiliary comparisons, archive/RMS controls, kappa and external power comparisons followed source outcome exposure; no new OSF preregistration. They do not replace either primary endpoint."
        ]
      ]
    },
