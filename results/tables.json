    {
      "id": "definitions",
      "caption": "Critical definitions for interpreting the comparisons",
      "columns": [
        "Quantity",
        "Definition"
      ],
      "rows": [
        [
          "Inclusion",
          "One decision across source arms: exclude nonfinite linked-mastoid channel-windows, SD <0.1 µV or peak-to-peak >1000 µV. No condition-specific window replacement."
        ],
        [
          "Common/CAR",
          "m=19^{-1}\\sum_jX_j; residual r_j=X_j-m. The common signal includes scalp-average and shared-reference contributions."
        ],
        [
          "Prediction",
          "Participant logit is the mean window logit. Five participant folds; training-only scalar normalization. External predictions average five source-fold probabilities."
        ],
        [
          "Quality",
          "Maximum peak-to-peak, fraction above 200 µV, median channel RMS, vertical/horizontal ocular RMS, maximum absolute EEG--ocular correlation; all before ocular regression. Strict quality: fraction ≤10% (N=187)."
        ],
        [
          "Power",
          "Welch two-second Hann segments, 50% overlap, 0.5-Hz bins; bands 1--4, 4--8, 8--13, 13--30, 30--40 Hz. Total 1--40 Hz power integrates bins before the logarithm, rather than summing band log-powers. Window log-powers averaged within person; CAR averages channel periodograms. Group ratio 10^{\\bar z_A-\\bar z_C}; Hedges' g uses pooled between-person SD."
        ],
        [
          "Residualization",
          "Training-only Ridge prediction of five standardized common bands from covariates, followed by standardized residuals and class-balanced logistic regression. Covariates enter jointly."
        ],
        [
          "Faithfulness",
          "Predicted-class logit drop after zeroing the top region minus mean drop from 100 channel-count-matched random masks; CAR perturbations reprojected to zero sum. Corrected-minus-uncorrected effect averages references and then additional initializations within person."
        ],
        [
          "Regions",
          "Frontal Fp1/Fp2/F7/F3/Fz/F4/F8; central C3/Cz/C4; temporal T7/T8; parietal P7/P3/Pz/P4/P8; occipital O1/O2. Ties follow this order."
        ],
        [
          "Uncertainty",
          "Diagnosis-stratified participant bootstrap; 2000 draws for core classification/faithfulness, 20,000 for power, covariate, auxiliary, kappa and RMS controls. Paired configurations resampled jointly; matching resamples pairs. Conditional on fitted models; pointwise, no multiplicity adjustment."
        ]
      ]
    },
